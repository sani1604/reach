import { ExtensionHasNoMethodError } from './errors.esnext';
import { useApi } from './api.esnext';

/**
 * Returns a function to mutate the `metafields` property of the checkout.
 * @publicDocs
 */
function useApplyMetafieldsChange() {
  const api = useApi();
  if ('applyMetafieldChange' in api) {
    return api.applyMetafieldChange;
  }
  throw new ExtensionHasNoMethodError('applyMetafieldChange', api.extension.target);
}

export { useApplyMetafieldsChange };
